# See docs/credentials.md for how to obtain each of these.
# REQUIRED values are marked; everything else has a working default
# or is only needed at deploy time.

# ---- Boltz (protein design + structure/affinity) — REQUIRED ----
# Sign up and create a key: https://api.boltz.com/console
# API docs: https://api.boltz.com/docs   (NOT docs.boltz.com)
# Use a TEST key (sk_bc_ws_test_...) for development: unbilled.
BOLTZ_API_KEY=
# Only needed for admin keys; workspace keys ignore it. Deploy-time.
BOLTZ_WORKSPACE_ID=

# ---- OpenAI (agents + realtime voice) — REQUIRED ----
# https://platform.openai.com/api-keys  (voice needs account credit)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Agents SDK tracing is ON by default and sends run content to OpenAI.
# Default to disabled; set to 0 only with explicit consent (see ARCHITECTURE.md §11).
OPENAI_AGENTS_DISABLE_TRACING=1

# ---- Data stores ----
# Must be a replica set — change streams carry job progress to the browser.
# docker-compose starts a single-node replica set for local dev.
MONGODB_URI=mongodb://localhost:27017/baobab?replicaSet=rs0

# ---- Storage ----
# Dev uses local disk, so R2 is not needed to develop.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/structures

# ---- Object storage (Cloudflare R2) — DEPLOY ONLY ----
# Needs an R2 subscription checkout before tokens can be created.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=baobab-structures

# ---- App ----
# Generate: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
SESSION_SECRET=
APP_BASE_URL=http://localhost:3000
DEFAULT_PROJECT_BUDGET_USD=25

# ---- NCBI / PubMed — OPTIONAL ----
# Email identifies us to NCBI. Key is optional: raises 3/s to 10/s.
NCBI_EMAIL=
NCBI_API_KEY=
