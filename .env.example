# ---- Boltz (protein design + structure/affinity) ----
# Key from https://api.boltz.bio  (redirects to api.boltz.com/console)
BOLTZ_API_KEY=
# Only needed for admin keys; workspace keys ignore it
BOLTZ_WORKSPACE_ID=

# ---- OpenAI (agents + realtime voice) ----
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Agents SDK tracing is ON by default and sends run content to OpenAI.
# Default to disabled; set to 0 only with explicit consent (see ARCHITECTURE.md §11).
OPENAI_AGENTS_DISABLE_TRACING=1

# ---- Data stores ----
# Must be a replica set — change streams carry job progress to the browser.
# docker-compose starts a single-node replica set for local dev.
MONGODB_URI=mongodb://localhost:27017/baobab?replicaSet=rs0

# ---- Object storage (Cloudflare R2, S3-compatible) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=baobab-structures

# ---- App ----
SESSION_SECRET=
APP_BASE_URL=http://localhost:3000
DEFAULT_PROJECT_BUDGET_USD=25

# ---- NCBI / PubMed (3 req/s unkeyed, 10 keyed; both params required by NCBI) ----
NCBI_EMAIL=
NCBI_API_KEY=
